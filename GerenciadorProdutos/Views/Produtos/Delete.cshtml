@using System.Globalization
@model GerenciadorProdutos.Models.Produto

@{
    ViewData["Title"] = "Excluir produto";
    var ptBR = new CultureInfo("pt-BR");
}

<h1 class="h3 mb-3 text-danger">Excluir produto</h1>
<div class="alert alert-warning">Tem certeza de que deseja excluir este produto?</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>
            <dt class="col-sm-3">Descrição</dt>
            <dd class="col-sm-9">@Model.Descricao</dd>
            <dt class="col-sm-3">Preço</dt>
            <dd class="col-sm-9">@Model.Preco.ToString("C", ptBR)</dd>
            <dt class="col-sm-3">Estoque</dt>
            <dd class="col-sm-9">@Model.QuantidadeEstoque</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>