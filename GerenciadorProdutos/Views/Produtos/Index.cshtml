@using System.Globalization
@model IEnumerable<GerenciadorProdutos.Models.Produto>

@* 
   Aluno: Jonathan Rodrigues Feitosa
   Prontuário: CB3030822
*@

@{
    ViewData["Title"] = "Produtos";
    var ptBR = new CultureInfo("pt-BR");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Produtos</h1>
    <a asp-action="Create" class="btn btn-primary">+ Novo produto</a>
</div>

@if (TempData["Mensagem"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensagem"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum produto cadastrado.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th class="text-end">Preço</th>
                        <th class="text-center">Estoque</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Nome</td>
                            <td>@item.Descricao</td>
                            <td class="text-end">@item.Preco.ToString("C", ptBR)</td>
                            <td class="text-center">
                                <span class="badge @(item.QuantidadeEstoque == 0 ? "bg-danger" : "bg-secondary")">@item.QuantidadeEstoque</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalhes</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}